// KHOJ Database Schema
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────
enum Role {
  USER
  ARTISAN
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ContentType {
  CRAFT
  FOOD
  FESTIVAL
  COMMUNITY
  MUSIC
  ARTISAN
  WORKSHOP
}

// ─── Users ───────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String    @unique
  passwordHash     String
  role             Role      @default(USER)
  avatar           String?
  bio              String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  artisan        Artisan?
  bookings       Booking[]
  collections    Collection[]
  journeys       Journey[]
  journals       JournalEntry[]
  compassResults AiCompassResult[]

  @@map("users")
}

// ─── Cultural Content ────────────────────────────────────
model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  region      String
  population  Int?
  language    String?
  description String
  imageUrl    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("communities")
}

model Craft {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  origin      String
  materials   String[]
  description String
  imageUrl    String?
  tags        String[]
  artisans    Artisan[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("crafts")
}

model Food {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  region      String
  ingredients String[]
  description String
  imageUrl    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("foods")
}

model Festival {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  month       String
  location    String
  description String
  imageUrl    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("festivals")
}

model Music {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  genre       String
  instruments String[]
  description String
  imageUrl    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("music")
}

// ─── Artisans & Workshops ────────────────────────────────
model Artisan {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciality String
  location   String
  experience Int // years
  bio        String?
  crafts     Craft[]
  workshops  Workshop[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("artisans")
}

model Workshop {
  id          String    @id @default(cuid())
  artisanId   String
  artisan     Artisan   @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  title       String
  description String
  location    String
  duration    Int // in hours
  maxSlots    Int
  price       Float // display only — no payment
  imageUrl    String?
  tags        String[]
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("workshops")
}

// ─── Bookings ────────────────────────────────────────────
model Booking {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshopId   String
  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  status       BookingStatus @default(PENDING)
  scheduledAt  DateTime
  participants Int           @default(1)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("bookings")
}

// ─── Collections ─────────────────────────────────────────
model Collection {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean          @default(false)
  items       CollectionItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("collections")
}

model CollectionItem {
  id           String      @id @default(cuid())
  collectionId String
  collection   Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentType  ContentType
  contentId    String
  note         String?
  createdAt    DateTime    @default(now())

  @@unique([collectionId, contentType, contentId])
  @@map("collection_items")
}

// ─── Journeys ────────────────────────────────────────────
model Journey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  summary   String?
  days      Json // AI-generated day-by-day itinerary
  duration  Int // days
  startCity String
  budget    String
  interests String[]
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journeys")
}

// ─── Journals ────────────────────────────────────────────
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  mood      String?
  location  String?
  photos    String[] // array of image URLs
  tags      String[]
  visitedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journal_entries")
}

// ─── AI Results ──────────────────────────────────────────
model AiCompassResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  mood      String[]
  result    Json // AI response data
  createdAt DateTime @default(now())

  @@map("ai_compass_results")
}
